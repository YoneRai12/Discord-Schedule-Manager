# 新しく作成した会議管理Bot専用のDiscord Botトークン
DISCORD_BOT_TOKEN=

# Botを動かすDiscordサーバーID（1サーバー専用）
DISCORD_GUILD_ID=

# 任意: 管理者以外に会議登録を許可するロールID。複数はカンマ区切り
MEETING_CREATOR_ROLE_IDS=

# 会議の既定値
MEETING_DEFAULT_DURATION_MINUTES=60
MEETING_DEFAULT_REMINDERS_MINUTES=30,0

# 個別DM通知の初期値。各メンバーがDMまたは@メンションで自分用に変更できる
MEETING_PERSONAL_DEFAULT_REMINDERS_MINUTES=60,10

# この分前の通知だけ @everyone する。既定は開始時だけ
MEETING_EVERYONE_OFFSETS_MINUTES=0
MEETING_SCHEDULER_INTERVAL_SECONDS=15
MEETING_MAX_LATE_MINUTES=10

# 自然言語整形用OpenAI API。URLやDiscord IDは送信前にローカル除去される
OPENAI_API_KEY=
OPENAI_MEETING_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=1200

# 任意: Google Sheets同期。両方設定した時だけ有効
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=60

# trueにした場合だけ会議URLをSheetsへ同期する。GPTには常に送らない
GOOGLE_SHEETS_SYNC_URLS=false

# 任意: 公開WEBへの片方向同期。URLと32文字以上のsecretの両方を設定した時だけ有効
MEETING_WEB_SYNC_URL=
MEETING_WEB_SYNC_SECRET=
# OpenAI Sitesの非公開サイトへ無人同期する場合だけ設定する。値はGitへ入れない
MEETING_WEB_AUTH_TOKEN=

MEETING_WEB_SYNC_INTERVAL_SECONDS=60
MEETING_WEB_SYNC_TIMEOUT_MS=8000
MEETING_WEB_SYNC_MAX_RETRIES=2
