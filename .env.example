# 新しく作成した会議管理Bot専用のDiscord Botトークン
DISCORD_BOT_TOKEN=

# Botを動かすDiscordサーバーID（1サーバー専用）
DISCORD_GUILD_ID=

# 任意: 管理者以外に会議登録を許可するロールID。複数はカンマ区切り
MEETING_CREATOR_ROLE_IDS=

# 会議の既定値
MEETING_DEFAULT_DURATION_MINUTES=60
MEETING_DEFAULT_REMINDERS_MINUTES=30,0

# 個別DM通知の初期値。各メンバーがDMまたは@メンションで自分用に変更できる
MEETING_PERSONAL_DEFAULT_REMINDERS_MINUTES=60,10

# この分前の通知だけ、その会議で「参加」を押した人をメンションする。既定は開始時だけ
MEETING_ATTENDEE_MENTION_OFFSETS_MINUTES=0
MEETING_SCHEDULER_INTERVAL_SECONDS=15
MEETING_MAX_LATE_MINUTES=10

# 会議AIプロバイダー。openai（安定運用）またはcodex_app_server（個人PCでの実験運用）
MEETING_AI_PROVIDER=openai

# OpenAI Responses API。URL・Discord ID・会議ID・登録済み呼び名は送信前にローカル除去される
OPENAI_API_KEY=
OPENAI_MEETING_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=1200

# MEETING_AI_PROVIDER=codex_app_server の場合だけ使用。ChatGPT Proログイン済みCodex CLIが必要
# App Serverはstdioだけで起動し、外部ポートは公開しない
CODEX_APP_SERVER_COMMAND=codex
CODEX_MEETING_MODEL=gpt-5.3-codex-spark
CODEX_REASONING_EFFORT=medium
CODEX_APP_SERVER_TIMEOUT_MS=60000

# Discord VC議事録（初期状態は無効）。音声は外部AIへ送らず、ローカルで文字起こしします。
MEETING_VOICE_ENABLED=false
# 議事録専用の非公開テキストチャンネルID（@everyoneの閲覧拒否を必須にします）
MEETING_VOICE_OUTPUT_CHANNEL_ID=
# ローカルバックアップは固定24時間。再処理しても期限は延長されません。
MEETING_VOICE_RETENTION_HOURS=24
MEETING_VOICE_ARCHIVE_DIR=voice-sessions
# 32バイトをBase64化した暗号鍵。実値は.envだけに保存し、Gitへ入れません。
MEETING_VOICE_ARCHIVE_KEY=
MEETING_VOICE_MAX_SESSION_MINUTES=240
MEETING_VOICE_NOTICE_INTERVAL_MINUTES=30
MEETING_VOICE_MAX_PARTICIPANTS=20
# 指定VCへの入室を開始何分前から自動同意確認の対象にするか
MEETING_VOICE_AUTO_START_EARLY_MINUTES=15
MEETING_VOICE_AUTO_START_POLL_SECONDS=30
# 例: .voice-venv/Scripts/python.exe
MEETING_VOICE_PYTHON_COMMAND=python
MEETING_VOICE_STT_MODEL=large-v3
MEETING_VOICE_STT_DEVICE=auto
# true時だけ、匿名化した文字起こしを現在のAIプロバイダーへ送って要約します。
MEETING_VOICE_AI_SUMMARY_ENABLED=false
# 公開情報として抽出・匿名化した主張だけを検索に使います。要約が有効な場合のみ使用します。
MEETING_VOICE_FACT_CHECK_ENABLED=false

# 任意: Google Sheets同期。両方設定した時だけ有効。初期化失敗時はSheetsだけ無効化しBotは継続する
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=60

# trueにした場合だけ会議URLをSheetsへ同期する。GPTには常に送らない
GOOGLE_SHEETS_SYNC_URLS=false

# 任意: 公開WEBへの片方向同期。URLと32文字以上のsecretの両方を設定した時だけ有効
MEETING_WEB_SYNC_URL=
MEETING_WEB_SYNC_SECRET=
# OpenAI Sitesの非公開サイトへ無人同期する場合だけ設定する。値はGitへ入れない
MEETING_WEB_AUTH_TOKEN=

MEETING_WEB_SYNC_INTERVAL_SECONDS=60
MEETING_WEB_SYNC_TIMEOUT_MS=8000
MEETING_WEB_SYNC_MAX_RETRIES=2
